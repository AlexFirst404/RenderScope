* text=auto
*.java text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
LICENSE text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.png binary
*.gif binary
*.jar binary

# Keep generated evidence bytes unchanged so linked SHA-256 fingerprints survive a checkout.
distribution/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/validation/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
