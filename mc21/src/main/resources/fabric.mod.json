{
  "schemaVersion": 1,
  "id": "renderscope",
  "version": "${version}",
  "name": "RenderScope",
  "description": "Find measured rendering work by mod, object type and exact world instance.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.renderscope.fabric.RenderScopeFabric"
    ]
  },
  "mixins": [
    "renderscope.fabric.mixins.json"
  ],
  "license": "LicenseRef-RenderScope-Source-Available-1.0",
  "icon": "renderscope-logo.png",
  "contact": {
    "sources": "https://github.com/AlexFirst404/RenderScope"
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
